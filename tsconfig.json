{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@exhibit-a/core": ["./packages/core/src/index.ts"],
      "@exhibit-a/tools": ["./packages/tools/src/index.ts"],
      "@exhibit-a/agents": ["./packages/agents/src/index.ts"],
      "@exhibit-a/llm": ["./packages/llm/src/index.ts"],
      "@exhibit-a/engines": ["./packages/engines/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "evals/**/*.ts", "scripts/**/*.ts"]
}
