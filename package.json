{
  "name": "exhibit-a",
  "version": "0.1.0",
  "private": true,
  "description": "Adjudicate whether a dashboard metric movement is a data artifact or a real change.",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "exhibit-a": "tsx apps/cli/src/index.ts",
    "cli": "tsx apps/cli/src/index.ts",
    "investigate": "tsx apps/cli/src/index.ts investigate",
    "approve": "tsx apps/cli/src/index.ts approve",
    "writeback": "tsx apps/cli/src/index.ts writeback",
    "rerun": "tsx apps/cli/src/index.ts rerun",
    "replay": "tsx apps/cli/src/index.ts replay",
    "cassette:d1": "tsx scripts/build-d1-cassette.ts",
    "cassette:d2": "tsx scripts/build-d2-cassette.ts",
    "record:nim": "tsx scripts/record-nim.ts",
    "fixture:edgar": "tsx scripts/build-edgar-fixture.ts",
    "fixture:discovery": "tsx scripts/build-discovery-fixture.ts",
    "eval": "tsx evals/run.ts",
    "eval:claims": "tsx evals/check_claims.ts",
    "web": "tsx apps/web/src/server.ts",
    "test": "node --import tsx --test packages/core/src/*.test.ts packages/tools/src/*.test.ts packages/agents/src/*.test.ts packages/llm/src/*.test.ts packages/engines/src/*.test.ts evals/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
