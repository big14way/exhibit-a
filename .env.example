# SAMPLE_MODE=true serves recorded tool results. No Zetaris, NVIDIA, or GPU required.
SAMPLE_MODE=true

ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
# Sent as the Zetaris user-agent header; include a contact email or URL.
ZETARIS_USER_AGENT=exhibit-a you@example.com
# Live Zetaris schema-store table that maps CIK to SIC division.
ZETARIS_SIC_TABLE=edgar.sic_edgar_usl
# HMAC secret for signed write contracts. Required for live shadow writes.
EXHIBIT_A_CONTRACT_SECRET=

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model IDs are configured, never guessed. Leave blank in SAMPLE_MODE: the
# committed cassette replays the three recorded Nemotron roles.
#   critic   nvidia/nemotron-3-nano-omni-30b-a3b-reasoning  (Defense Counsel, JSON objections)
#   safety   nvidia/nemotron-3.5-content-safety             (second content-safety layer)
#   embed    nvidia/nemotron-3.5-embed-1b                   (H-MEM semantic recall)
# For a live run set NVIDIA_API_KEY and the role models you want. Ultra is
# configurable as the critic but its current route emits chain-of-thought
# instead of strict JSON for this prompt.
NIM_LEAD_MODEL=
NIM_CRITIC_MODEL=
NIM_SCOUT_MODEL=
NIM_EMBED_MODEL=
NIM_SAFETY_MODEL=
# Optional per-million-token prices used by the spend ledger.
NIM_PRICE_INPUT_PER_M=
NIM_PRICE_OUTPUT_PER_M=

SEC_USER_AGENT=exhibit-a you@example.com
# Optional browser-shaped UA for SEC's edge; SEC_USER_AGENT is still sent in From.
SEC_BROWSER_UA=
COMPANY_DNS_USER_AGENT=exhibit-a you@example.com

LOG_DIR=./logs
SPEND_CAP_USD=8
