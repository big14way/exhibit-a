# SAMPLE_MODE=true serves recorded tool results. No Zetaris, NVIDIA, or GPU required.
SAMPLE_MODE=true

ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_API_KEY=
ZETARIS_ORG_ID=
# Must include a contact email or URL (SEC and company_dns rate limits).
ZETARIS_USER_AGENT=exhibit-a you@example.com

NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Model IDs are configured, never guessed. Leave blank in SAMPLE_MODE.
NIM_LEAD_MODEL=
NIM_CRITIC_MODEL=
NIM_SCOUT_MODEL=
NIM_EMBED_MODEL=
NIM_SAFETY_MODEL=
# Optional per-million-token prices used by the spend ledger.
NIM_PRICE_INPUT_PER_M=
NIM_PRICE_OUTPUT_PER_M=

SEC_USER_AGENT=exhibit-a you@example.com
COMPANY_DNS_USER_AGENT=exhibit-a you@example.com

LOG_DIR=./logs
SPEND_CAP_USD=8
